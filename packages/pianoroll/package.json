{
  "version": "0.2.0",
  "name": "solid-pianoroll",
  "description": "Pianoroll UI Control for Solid JS apps",
  "license": "MIT",
  "author": "jdachtera",
  "contributors": [],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jdachtera/solid-music-ui.git",
    "directory": "packages/pianoroll"
  },
  "homepage": "https://github.com/jdachtera/solid-music-ui/tree/main/packages/pianoroll#readme",
  "bugs": {
    "url": "https://github.com/jdachtera/solid-music-ui/issues"
  },
  "private": false,
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "@solid-music-ui/source": "./src/index.tsx",
    "solid": {
      "development": "./dist/dev.jsx",
      "import": "./dist/index.jsx"
    },
    "development": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/dev.js"
      },
      "require": "./dist/dev.cjs"
    },
    "import": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "require": "./dist/index.cjs"
  },
  "scripts": {
    "dev": "vite serve dev",
    "build-dev": "vite build dev",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && vitest run --mode ssr",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "solid-viewport": "workspace:^",
    "solid-piano-keyboard": "workspace:^"
  },
  "peerDependencies": {
    "solid-js": "^1.6.0"
  },
  "devDependencies": {
    "@tonejs/midi": "^2.0.28",
    "esbuild-css-modules-plugin": "^2.7.1",
    "tone": "^14.7.77",
    "typescript-plugin-css-modules": "^4.1.1"
  },
  "keywords": [
    "solid"
  ]
}
