{
  "version": "1.6.0",
  "name": "solid-waveform",
  "description": "Waveform UI Control for Solid JS apps",
  "license": "MIT",
  "author": "jdachtera",
  "contributors": [],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jdachtera/solid-music-ui.git",
    "directory": "packages/waveform"
  },
  "homepage": "https://github.com/jdachtera/solid-music-ui/tree/main/packages/waveform#readme",
  "bugs": {
    "url": "https://github.com/jdachtera/solid-music-ui/issues"
  },
  "private": false,
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@solid-music-ui/source": "./src/index.tsx",
      "solid": "./dist/index.jsx",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "dev": "vite serve dev",
    "build-dev": "vite build dev",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "solid-viewport": "workspace:^"
  },
  "peerDependencies": {
    "solid-js": "^1.6.0"
  },
  "keywords": [
    "solid"
  ]
}
