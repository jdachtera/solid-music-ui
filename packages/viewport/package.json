{
  "version": "0.3.1",
  "name": "solid-viewport",
  "description": "One viewport core for scrollable & zoomable content in Solid JS — virtual lists, waveforms, piano rolls, keyboards",
  "license": "MIT",
  "author": "jdachtera",
  "contributors": [],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jdachtera/solid-music-ui.git",
    "directory": "packages/viewport"
  },
  "homepage": "https://github.com/jdachtera/solid-music-ui/tree/main/packages/viewport#readme",
  "bugs": {
    "url": "https://github.com/jdachtera/solid-music-ui/issues"
  },
  "private": false,
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@solid-music-ui/source": "./src/index.tsx",
      "solid": "./dist/index.jsx",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "dev": "vite serve dev",
    "build-dev": "vite build dev",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "solid",
    "solid-js",
    "virtual",
    "virtual-list",
    "virtualization",
    "viewport",
    "scroll",
    "zoom",
    "windowing"
  ],
  "peerDependencies": {
    "solid-js": "^1.6.0"
  }
}
