{
  "compilerOptions": {
    "strict": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true,
    "types": [],
    // A workspace package resolves to its sibling's src/ rather than its dist/,
    // so typecheck, tests and the demos never wait on (or go stale behind) a
    // build. Published consumers don't set the condition and get dist/.
    "customConditions": ["@solid-music-ui/source"]
  }
}
