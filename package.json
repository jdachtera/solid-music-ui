{
  "name": "solid-music-ui",
  "private": true,
  "type": "module",
  "description": "Solid JS components for music apps: viewport, waveform, piano roll",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build-dev": "pnpm -r build-dev",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.76.0",
    "solid-js": "^1.9.14",
    "tsup": "^8.5.1",
    "tsup-preset-solid": "^2.2.0",
    "typescript": "~5.9.3",
    "vite": "^8.1.5",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.11"
  }
}
